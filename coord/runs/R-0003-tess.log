[package]
name = "libarchive"
description = "Streaming archive and compression reading and writing for Android file managers"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true

[lib]
name = "libarchive"
# `rlib` so the JNI crate and the tests can link it; `cdylib` is built by the `jni` crate.
crate-type = ["rlib"]

[dependencies]
brotli.workspace = true
bzip2.workspace = true
crc32fast.workspace = true
deflate64.workspace = true
flate2.workspace = true
lz4_flex.workspace = true
lzma-rust2.workspace = true
ppmd-rust.workspace = true
zstd.workspace = true
aes.workspace = true
aes-gcm.workspace = true
sha1.workspace = true
hmac.workspace = true
pbkdf2.workspace = true
# The 7Z container, the legacy long tail, and the codecs they carry with them.
sevenz-rust2 = { workspace = true, features = ["util", "compress"] }
unarc-rs.workspace = true

[dev-dependencies]
criterion = { version = "0.8", default-features = false, features = ["cargo_bench_support"] }
proptest = "1"
rand = "0.9"
tempfile = "3"

[features]
default = []
# Reading the long tail: RAR, ARJ, ACE, ARC, Zoo, LZH, SQ, UCB, UC2, Ha, Hyp, Ice.
# On by default because a file manager that silently cannot open a `.rar` is broken.
legacy = []
# Formats that pull in extra dependencies and are almost never met.
exotic = []

[[bench]]
name = "zip"
harness = false

[[bench]]
name = "listing"
harness = false===
[workspace]
resolver = "2"
members = ["libarchive", "jni"]

[workspace.package]
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
license = "Apache-2.0"
repository = "https://github.com/MaxrregMustermann/libarchive-rs"

[workspace.dependencies]
libarchive = { path = "libarchive" }
# Compression codecs. Every one of these is a pure-Rust or statically-linked C implementation with
# no runtime dependency on the platform, so the same code paths are used on the host and on Android.
brotli = { version = "9", default-features = false, features = ["std"] }
bzip2 = { version = "0.6", default-features = false }
crc32fast = "1.5"
deflate64 = "0.1"
flate2 = { version = "1.1", default-features = false, features = ["rust_backend"] }
lz4_flex = { version = "0.14", default-features = false, features = ["std", "frame"] }
lzma-rust2 = { version = "0.21", features = ["std"] }
ppmd-rust = "1.5"
zstd = { version = "0.14", default-features = false }
aes = "0.9"
aes-gcm = "0.10"
sha1 = "0.10"
hmac = "0.13"
pbkdf2 = "0.13"
# Reused wholesale for the long tail of legacy formats. See libarchive/src/lib.rs.
unarc-rs = { version = "0.7", default-features = false }
sevenz-rust2 = { version = "0.23", default-features = false }

[profile.release]
# Decompression is the hot path and this crate exists to make archives open fast, so the trade is
# binary size for speed. Measured at around 13% on reading a deflate archive.
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
strip = true

[profile.bench]
inherits = "release"
